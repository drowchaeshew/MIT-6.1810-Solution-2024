        <mxCell id="QysVTacqmiQ-omiVzkKP-24" value="commit()" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-1473.1399999999999" y="2873.88" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="QysVTacqmiQ-omiVzkKP-25" value="通常不会有超过一个进程尝试 commit：尝试commit需要获取 log.lock 锁，再判断（log.commiting = 0）&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;第一个获取锁的进程会在放开锁之前先让committing为1，所以不要紧&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" parent="1" vertex="1">
          <mxGeometry x="-2048.14" y="2817.01" width="180" height="155" as="geometry" />
        </mxCell>
        <mxCell id="QysVTacqmiQ-omiVzkKP-52" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endFill=1;" parent="1" source="QysVTacqmiQ-omiVzkKP-26" target="QysVTacqmiQ-omiVzkKP-25" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QysVTacqmiQ-omiVzkKP-26" value="对于 end_op() 需要 commit 的情况：中途放锁是更好的选择。（commit中会重新加锁）&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;考虑到 begin_op()、log_write()、end_op() 都需要获取锁才能推进。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;因为&lt;u&gt;&lt;b&gt;没有必要 end_op() 的前半部和 commit() 原子地进行&lt;/b&gt;&lt;/u&gt;，所以放锁会更好（让别的操作可以持锁，提高并行度）&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=left;" parent="1" vertex="1">
          <mxGeometry x="-2283.14" y="2806.38" width="205" height="175" as="geometry" />
        </mxCell>
