        </mxCell>
        <mxCell id="K7GqSFerp0KWnCtqVweI-19" value="负责处理终端相关&lt;br&gt;的内容&lt;br&gt;缓存等也在这里处理" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" parent="1" vertex="1">
