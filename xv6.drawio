        <mxCell id="OFN_G1PEfmtCfyvyEsAV-36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="OFN_G1PEfmtCfyvyEsAV-37" target="OFN_G1PEfmtCfyvyEsAV-35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OFN_G1PEfmtCfyvyEsAV-37" value="机器模式(M)下才能执行的代码。&lt;br&gt;* 设置程序状态字(PSW)&lt;br&gt;* 启动时钟中断&lt;br&gt;* 设置 mret 的地址" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="1285" y="542.5" width="180" height="65" as="geometry" />
        </mxCell>
        <mxCell id="OFN_G1PEfmtCfyvyEsAV-38" value="userinit()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;" edge="1" parent="1" source="OFN_G1PEfmtCfyvyEsAV-39" target="OFN_G1PEfmtCfyvyEsAV-46">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OFN_G1PEfmtCfyvyEsAV-39" value="kernel/main.c" style="whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1085" y="630" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="OFN_G1PEfmtCfyvyEsAV-40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="OFN_G1PEfmtCfyvyEsAV-41" target="OFN_G1PEfmtCfyvyEsAV-39">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OFN_G1PEfmtCfyvyEsAV-41" value="运行在监管模式（S）下，&lt;br&gt;也就是内核模式。&lt;br&gt;现在内核已经起来了。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="1285" y="625" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="OFN_G1PEfmtCfyvyEsAV-42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="OFN_G1PEfmtCfyvyEsAV-43" target="OFN_G1PEfmtCfyvyEsAV-39">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1245" y="765" />
              <mxPoint x="1245" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="OFN_G1PEfmtCfyvyEsAV-43" value="OS启动的核心代码在这里。&lt;br&gt;* 初始化 console&lt;div&gt;* 分配物理内存&lt;br&gt;** 配置页表&lt;br&gt;* 配置进程表&lt;/div&gt;&lt;div&gt;** 中断向量设置&lt;br&gt;** 硬件中断（PLIC）&lt;/div&gt;&lt;div&gt;* 文件系统（buffer、inode、文件表等）&lt;br&gt;* 创建第一个用户进程 (pid=1)&lt;br&gt;* scheduler() 进入用户态&lt;br&gt;&lt;br&gt;(&amp;nbsp; &amp;nbsp;*：只一个进程做；&lt;br&gt;&amp;nbsp; &amp;nbsp; **：所有进程做&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; )&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="1285" y="685" width="220" height="200" as="geometry" />
        </mxCell>
        <mxCell id="OFN_G1PEfmtCfyvyEsAV-44" value="按照所处的阶段分。&lt;br&gt;&lt;br&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;0. 寄存器栈准备前；&lt;/span&gt;&lt;/div&gt;1. 在机器模式；&lt;div&gt;2. 在内核模式；&lt;br&gt;&lt;br&gt;注意观察每个阶段都在做什么。&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=left;" vertex="1" parent="1">
