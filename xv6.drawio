          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tXazWIrjS432T3LF4Olq-73" value="* 创建用户页表&lt;br&gt;&lt;div&gt;* 创建用户页面布局 (uvmalloc()) 并从 ELF 文件中读取&lt;br&gt;* 准备用户栈&lt;sup&gt;(压入参数）&lt;/sup&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;* 设置上下文（代码入口地址、堆栈等）&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="1562.65" width="230" height="98.44" as="geometry" />
        </mxCell>
        <mxCell id="tXazWIrjS432T3LF4Olq-74" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="tXazWIrjS432T3LF4Olq-75" target="tXazWIrjS432T3LF4Olq-48">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tXazWIrjS432T3LF4Olq-75" value="这个布局的创建，见：&lt;br&gt;kernel/exec.c:exec()" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="1198.8600000000001" width="130" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bjhwinDFFn8TY_-sBGw_" name="Lab 4 中断">
    <mxGraphModel dx="815" dy="482" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-1" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;trap中三个重要的寄存器&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;* stvec（指向中断向量表）&lt;/div&gt;&lt;div&gt;* scause（指明原因）&lt;/div&gt;&lt;div&gt;* sstatus（保存状态）&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;trap发生时，硬件设置上述三个寄存器（并进入内核态）。其中 sstatus 内容较多，包括：&lt;br&gt;* 记录中断前的模式(用户/内核)&lt;/div&gt;&lt;div&gt;* 关/开中断&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="1027" y="260" width="193" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-2" value="&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;三个重要现场&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;pc, sp, satp（页表）&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;需要在中断处理中保存&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="1027" y="483.75" width="193" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-3" value="切换页表的时候用了 fence&lt;div&gt;——这是第一次使用 fence&lt;br&gt;&lt;br&gt;原因：内存环境切换了。&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="814.25" y="503.75" width="161.5" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ZwOE3ZBuI64jf7nLvkkN-5" target="ZwOE3ZBuI64jf7nLvkkN-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-5" value="&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;内存的现场需要在进程陷阱的时候恢复：需要在 proc 结构体（PCB） 中保存&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="1027" y="593.75" width="193" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-6" value="&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;struct trapframe&lt;/b&gt;&amp;nbsp;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;* kernel_satp&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;* kernel_sp&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* kernel_trap （进一步执行的地址，即 usertrap()）&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="814.25" y="588.75" width="181.5" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ZwOE3ZBuI64jf7nLvkkN-6" target="ZwOE3ZBuI64jf7nLvkkN-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ZwOE3ZBuI64jf7nLvkkN-9" target="ZwOE3ZBuI64jf7nLvkkN-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-9" value="&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;在中断结束后、还处于内核态时，相关现场也需要保存回PCB中&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="1027" y="693.75" width="193" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ZwOE3ZBuI64jf7nLvkkN-11" target="ZwOE3ZBuI64jf7nLvkkN-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-11" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;中断向量：&lt;/span&gt;&lt;/div&gt;这也是一个现场！即将切换状态时要注意设置对应状态遇到中断时的处理函数入口&lt;br&gt;（对用户态是 uservec，对内核态是 kernelvec)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="1255" y="583.75" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-12" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;imageBorder=default;" vertex="1" parent="1">
          <mxGeometry x="410" y="273.75" width="369.16" height="457.88" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ZwOE3ZBuI64jf7nLvkkN-14" target="ZwOE3ZBuI64jf7nLvkkN-12">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="595" y="803.75" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-14" value="为了避免影响通用寄存器，&lt;br&gt;上述流程被按需&lt;br&gt;安排到了ASM和C中" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="609.1599999999999" y="773.75" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ZwOE3ZBuI64jf7nLvkkN-16" target="ZwOE3ZBuI64jf7nLvkkN-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-16" value="&lt;div style=&quot;line-height: 80%;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;用户中断发生时：&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;lt;关中断&amp;gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; 1. 进入到中断处理函数 &amp;lt;-------------------+&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; * 包括ASM和C语言的部分。&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; * ASM 部分：$stvec&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; * C 语言部分：trapframe-&amp;gt;kernel_trap&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; 2. 保存用户上下文：-----------------------+-----+&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; * 寄存器：-&amp;gt; trapframe&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp;|&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; * 页表：&amp;nbsp; -&amp;gt; (不用保存，PCB里本来就有)&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp;|&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; * PC：&amp;nbsp; &amp;nbsp; -&amp;gt; PCB&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp;|&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; 3. 切换到内核上下文：&amp;lt;--------------------+--+&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; * 设置寄存器：内核的 SP，HartID，页表&amp;nbsp; &amp;nbsp;|&amp;nbsp; |&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; 4. 切换中断向量: 设置寄存器 kernelvec&amp;nbsp; &amp;nbsp; &amp;nbsp;|&amp;nbsp; |&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;lt;/开中断&amp;gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;|&amp;nbsp; |&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; |&amp;nbsp; |&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;判断逻辑并执行;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;|&amp;nbsp; |&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; |&amp;nbsp; |&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;lt;关中断&amp;gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; |&amp;nbsp; |&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; 5. 设置中断函数入口 ----------------------+&amp;nbsp; |&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; * 包括ASM和C语言的部分。&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;|&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; * ASM 的部分：$stvec&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;|&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; * C 语言的部分：trapframe-&amp;gt;kernel_trap&amp;nbsp; &amp;nbsp;|&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; 6. 保存内核上下文 ---------------------------+&amp;nbsp; |&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; * 内核的SP, 页表, HartID -&amp;gt; trapframe&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;|&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; 7. 设置 sstatus&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;|&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; 8. 切换到用户上下文: PC, 寄存器，页表 &amp;lt;---------+&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; 9. sret, 恢复到用户态&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;lt;/开中断&amp;gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Ubuntu Mono;fontSize=5;" vertex="1" parent="1">
          <mxGeometry x="230" y="414.6600000000001" width="150" height="176.06" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ZwOE3ZBuI64jf7nLvkkN-18" target="ZwOE3ZBuI64jf7nLvkkN-12">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="595" y="873.75" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-18" value="和用户进程相关的放在 PCB;&lt;div&gt;和内核相关的放在 trapframe&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="610" y="843.75" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ZwOE3ZBuI64jf7nLvkkN-20" target="ZwOE3ZBuI64jf7nLvkkN-12">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="595" y="953.75" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-20" value="有趣的观察：没有保存内核的通用寄存器。&lt;div&gt;原因：只有被中断的进程才需要保存寄存器。&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="610" y="913.75" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ZwOE3ZBuI64jf7nLvkkN-22" target="ZwOE3ZBuI64jf7nLvkkN-12">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="595" y="833.75" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ZwOE3ZBuI64jf7nLvkkN-22" value="内核态的中断比较简单：&lt;div&gt;因为重用了内核栈和内核地址空间，处理起来就像&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;函数调用&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="410" y="803.75" width="170" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
