          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-26" value="一些正常的缓冲读写操作。&lt;div&gt;通常来自上层调用&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="900" y="460.1300000000001" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-27" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endFill=1;" edge="1" parent="1" source="bT8O-OSn51S5kuxaBPru-28" target="bT8O-OSn51S5kuxaBPru-20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-28" value="&lt;div&gt;将修改的 bbuf 的 blockno &lt;br&gt;记录到 日志缓冲中&lt;br&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="900" y="526.3800000000001" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-29" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endFill=1;" edge="1" parent="1" source="bT8O-OSn51S5kuxaBPru-30" target="bT8O-OSn51S5kuxaBPru-28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-30" value="通常不会超过日志缓冲区大小，因为在 begin_op() 中，如果长度不足，会被锁住" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="1080" y="521.3800000000001" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-31" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endFill=1;" edge="1" parent="1" source="bT8O-OSn51S5kuxaBPru-32" target="bT8O-OSn51S5kuxaBPru-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-32" value="outstanding 计数-1。&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;1. 如果没有在执行的 FS Syscall，本进程负责 commit() ；&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;2. 由于减少了对缓冲块的需要，唤醒其他在 begin_op() 等待的进程，使他们尝试推进一次。&lt;/div&gt;&lt;div&gt;&lt;br&gt;(commit: 写入日志，并写入数据区)&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="530" y="557.6300000000001" width="189" height="133.75" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-33" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endFill=1;" edge="1" parent="1" source="bT8O-OSn51S5kuxaBPru-34" target="bT8O-OSn51S5kuxaBPru-39">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-34" value="commit()" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="603.8800000000001" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-35" value="通常不会有超过一个进程尝试 commit：尝试commit需要获取 log.lock 锁，再判断（log.commiting = 0）&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;第一个获取锁的进程会在放开锁之前先让committing为1，所以不要紧&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="325" y="547.0100000000002" width="180" height="155" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-36" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endFill=1;" edge="1" parent="1" source="bT8O-OSn51S5kuxaBPru-37" target="bT8O-OSn51S5kuxaBPru-35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-37" value="对于 end_op() 需要 commit 的情况：中途放锁是更好的选择。（commit中会重新加锁）&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;考虑到 begin_op()、log_write()、end_op() 都需要获取锁才能推进。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;因为&lt;u&gt;&lt;b&gt;没有必要 end_op() 的前半部和 commit() 原子地进行&lt;/b&gt;&lt;/u&gt;，所以放锁会更好（让别的操作可以持锁，提高并行度）&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="90" y="536.3800000000001" width="205" height="175" as="geometry" />
        </mxCell>
        <mxCell id="bT8O-OSn51S5kuxaBPru-38" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=block;endFill=0;" edge="1" parent="1" source="bT8O-OSn51S5kuxaBPru-39" target="bT8O-OSn51S5kuxaBPru-41">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
