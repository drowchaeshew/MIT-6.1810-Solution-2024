        </mxCell>
        <mxCell id="K7GqSFerp0KWnCtqVweI-21" value="这边的过程：&lt;div&gt;&lt;u&gt;中断的上半部&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;由设备引起的，立刻、快速执行的，是上半部（如处理磁盘读取到一块内容的事件）&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;由 因等待设备完成操作而被挂起的 进程执行的、时间较长的操作，是下半部（如 read() 读取磁盘内容）&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" parent="1" vertex="1">
          <mxGeometry x="-830" y="920" width="190" height="175" as="geometry" />
        </mxCell>
        <mxCell id="K7GqSFerp0KWnCtqVweI-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="K7GqSFerp0KWnCtqVweI-22" target="K7GqSFerp0KWnCtqVweI-21" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="K7GqSFerp0KWnCtqVweI-22" value="上半部在完成任务后会唤醒下半部等待的进程，执行需要的工作" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" parent="1" vertex="1">
          <mxGeometry x="-830" y="1120" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="K7GqSFerp0KWnCtqVweI-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="K7GqSFerp0KWnCtqVweI-24" target="K7GqSFerp0KWnCtqVweI-2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="K7GqSFerp0KWnCtqVweI-24" value="从控制台读取" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" parent="1" vertex="1">
          <mxGeometry x="-640" y="810" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="K7GqSFerp0KWnCtqVweI-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="K7GqSFerp0KWnCtqVweI-26" target="K7GqSFerp0KWnCtqVweI-30" edge="1">
          <mxGeometry relative="1" as="geometry" />
