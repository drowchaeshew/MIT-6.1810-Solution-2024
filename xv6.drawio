        <mxCell id="QysVTacqmiQ-omiVzkKP-17" value="outstanding 计数+1&lt;br&gt;(outstanding 代表了当前正在进行的 FS syscall 的数量）&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;如下几种情况需要等待：&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;1. 日志正在被（其他进程）提交——提交后可通过；&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;2. 日志预留的、用于恢复的缓冲的块(log.lh.n)的空间不足——其他进程 end_op() 后可通过&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" parent="1" vertex="1">
          <mxGeometry x="-1843.1399999999999" y="2592.63" width="189" height="175" as="geometry" />
        </mxCell>
        <mxCell id="QysVTacqmiQ-omiVzkKP-41" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endFill=1;" parent="1" source="QysVTacqmiQ-omiVzkKP-18" target="QysVTacqmiQ-omiVzkKP-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QysVTacqmiQ-omiVzkKP-18" value="一些正常的缓冲读写操作。&lt;div&gt;通常来自上层调用&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" parent="1" vertex="1">
          <mxGeometry x="-1473.1399999999999" y="2730.13" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="QysVTacqmiQ-omiVzkKP-42" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endFill=1;" parent="1" source="QysVTacqmiQ-omiVzkKP-20" target="QysVTacqmiQ-omiVzkKP-11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QysVTacqmiQ-omiVzkKP-20" value="&lt;div&gt;将修改的 bbuf 的 blockno &lt;br&gt;记录到 日志缓冲中&lt;br&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" parent="1" vertex="1">
          <mxGeometry x="-1473.1399999999999" y="2796.38" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="QysVTacqmiQ-omiVzkKP-49" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endFill=1;" parent="1" source="QysVTacqmiQ-omiVzkKP-21" target="QysVTacqmiQ-omiVzkKP-20" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QysVTacqmiQ-omiVzkKP-21" value="通常不会超过日志缓冲区大小，因为在 begin_op() 中，如果长度不足，会被锁住" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" parent="1" vertex="1">
          <mxGeometry x="-1293.1399999999999" y="2791.38" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="QysVTacqmiQ-omiVzkKP-50" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endFill=1;" parent="1" source="QysVTacqmiQ-omiVzkKP-23" target="QysVTacqmiQ-omiVzkKP-12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QysVTacqmiQ-omiVzkKP-23" value="outstanding 计数-1。&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;1. 如果没有在执行的 FS Syscall，本进程负责 commit() ；&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;2. 由于减少了对缓冲块的需要，唤醒其他在 begin_op() 等待的进程，使他们尝试推进一次。&lt;/div&gt;&lt;div&gt;&lt;br&gt;(commit: 写入日志，并写入数据区)&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=center;" parent="1" vertex="1">
          <mxGeometry x="-1843.1399999999999" y="2827.63" width="189" height="133.75" as="geometry" />
        </mxCell>
        <mxCell id="QysVTacqmiQ-omiVzkKP-39" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endFill=1;" parent="1" source="QysVTacqmiQ-omiVzkKP-24" target="QysVTacqmiQ-omiVzkKP-27" edge="1">
          <mxGeometry relative="1" as="geometry" />
